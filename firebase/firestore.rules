rules_version = '2';
// Expense Tracker: every user can only see and change their own data.
// A profile (users/{uid}) can only be created with the invite code stored in config/app,
// and nothing under a user is readable or writable without that profile.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isMember(uid) { return isOwner(uid) && exists(/databases/$(db)/documents/users/$(uid)); }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.invite == get(/databases/$(db)/documents/config/app).data.inviteCode;
      allow update: if isMember(uid) && request.resource.data.invite == resource.data.invite;
      allow delete: if false;

      match /{sub=**} {
        allow read, write: if isMember(uid);
      }
    }

    // App settings (invite code) are only editable in the Firebase console.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
