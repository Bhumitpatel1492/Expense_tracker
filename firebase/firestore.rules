rules_version = '2';
// Expense Tracker security rules.
// - users/{uid}: own profile only; created only with the invite code in config/app.
// - books/{bookId}: visible only to its members (memberUids); the owner manages name and members,
//   a member may only remove themselves; entries are readable/writable by members only.
// - mobiles/{mobile}: lookup (mobile -> uid, name) so an owner can add a member by mobile number.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isMember(uid) { return isOwner(uid) && exists(/databases/$(db)/documents/users/$(uid)); }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.invite == get(/databases/$(db)/documents/config/app).data.inviteCode;
      allow update: if isMember(uid) && request.resource.data.invite == resource.data.invite;
      allow delete: if false;

      match /{sub=**} {
        allow read, write: if isMember(uid);
      }
    }

    match /mobiles/{mobile} {
      allow read: if hasProfile();
      allow create, update: if hasProfile() && request.resource.data.uid == request.auth.uid
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.mobile == mobile;
      allow delete: if false;
    }

    match /books/{bookId} {
      allow read: if hasProfile() && request.auth.uid in resource.data.memberUids;
      allow create: if hasProfile()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if hasProfile() && (
        // owner: rename, add or remove members (and stays owner + member)
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.memberUids)
        ||
        // member: leave the book (remove only themselves)
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet()))
      );
      allow delete: if hasProfile() && resource.data.ownerUid == request.auth.uid;

      match /transactions/{txId} {
        allow read, write: if hasProfile()
          && request.auth.uid in get(/databases/$(db)/documents/books/$(bookId)).data.memberUids;
      }
    }

    // App settings (invite code) are only editable in the Firebase console.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
